# AlphaCare Client & Backend Environment Variables Reference (Variable Names Only)

# Supabase Connectivity (Frontend & Backend)
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API Configuration (Frontend Client)
EXPO_PUBLIC_BACKEND_URL=http://localhost:3000

# AI Engine Integration (Backend Only - M7 & M9)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration (M13 & M14)
PORT=3000
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# Push Notifications (Backend Only - M10)
FCM_SERVER_KEY=your_firebase_server_key_here

